# CloudDeck / ddc: the name of every setting that comes from a file or from the environment. Placeholders only; never commit real values.
#
# CloudDeck does NOT read a ".env" file. This file only documents the names:
#   * Part 1 lists the keys of secrets.env (same KEY=value syntax). `ddc init` creates the real file for you, owner-only
#     (mode 0600 on Linux/macOS), in the secrets directory (default ~/.config/clouddeck/, see Part 2).
#   * Part 2 lists process environment variables (all optional, all commented out here) that move files or change behaviour.
# Everything else (limits, repos, profiles) lives in config.toml: see config.example.toml.

# ---------------------------------------------------------------------------------------------------------------------------------
# Part 1: keys of secrets.env (read from that FILE only, never from the process environment)
# ---------------------------------------------------------------------------------------------------------------------------------

# Akash Console API key (https://console.akash.network, API Keys). Required. It can spend your Akash balance: use a dedicated,
# low-balance account. It stays on this PC and is never sent to any rented box.
AKASH_API_KEY=

# Passphrase that encrypts checkpoints (gpg AES256). `ddc install` generates it if missing. It IS copied to the dev box so that the
# box can encrypt checkpoints. Keep a copy in a password manager: if it is lost, every checkpoint is unrecoverable.
DDC_BACKUP_PASSPHRASE=

# Optional. Claude Code login token for the dev box. Only sent when `push_claude_credentials = true` in config.toml (default: false).
CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------------------------------------------------------------------------
# Part 2: process environment variables (all optional)
# ---------------------------------------------------------------------------------------------------------------------------------

# Where things live. Defaults: config in %APPDATA%\clouddeck (Windows) or ~/.config/clouddeck (Linux, macOS, WSL; honours
# XDG_CONFIG_HOME); secrets in ~/.config/clouddeck; state in %LOCALAPPDATA%\clouddeck (Windows) or ~/.local/state/clouddeck
# (honours XDG_STATE_HOME). DDC_CONFIG is a file path, the other two are directories.
# DDC_CONFIG=/path/to/config.toml
# DDC_SECRETS_DIR=/path/to/secrets-dir
# DDC_STATE_DIR=/path/to/state-dir

# Path of the gpg binary (default: gpg on PATH; on Windows also the gpg bundled with Git for Windows).
# DDC_GPG=/path/to/gpg

# Akash Console API base URL (default https://console-api.akash.network). Only change it to point at a test double.
# DDC_AKASH_API=https://console-api.akash.network

# CloudDeck: akash (default), demo (simulated, touches nothing) or a plugin name; the same as `clouddeck -p NAME`.
# CLOUDDECK_PROVIDER=demo
# CloudDeck: any non-empty value shows full tracebacks instead of a one-line error.
# CLOUDDECK_DEBUG=1

# `clouddeck-remote`, the client that `clouddeck serve --tunnel` installs on the dev box (set these on the BOX, not on your PC).
# URL default: http://127.0.0.1:8765 (the end of the SSH reverse tunnel). Token default: the file ~/.config/clouddeck/token
# that `clouddeck serve --tunnel` pushed.
# CLOUDDECK_URL=http://127.0.0.1:8765
# CLOUDDECK_TOKEN=cdk_example

# Test seams, used by the test suite and the simulated provider. Do not set these in normal use.
# DDC_STATE_URL=            git URL used to verify checkpoints
# DDC_STATE_REMOTE=         state repo URL on the lease
# CLOUDDECK_DEMO_LATENCY=0  seconds of fake latency in the demo provider
# CLOUDDECK_DEMO_SSH_FAIL=1 make the demo provider's interactive ssh fail
